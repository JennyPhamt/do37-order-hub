# Đô 37 B2B Order Hub — biến môi trường mẫu. KHÔNG điền secret thật vào file này.
# Sao chép thành .env.local khi chạy máy cá nhân (.env* đã nằm trong .gitignore).

# Chế độ dữ liệu: "demo" (mặc định, lưu trên trình duyệt) hoặc "supabase" (CHƯA cài đặt).
NEXT_PUBLIC_DATA_MODE=demo

# --- Chỉ dùng khi nối Supabase ở giai đoạn pilot (chưa dùng trong bản demo) ---
# URL và anon key được phép xuất hiện ở trình duyệt; quyền thật do RLS kiểm soát.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# CHỈ dùng phía server (Route Handler / worker). Tuyệt đối không thêm tiền tố NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Secret để băm HMAC mã truy cập đại lý.
DEALER_CODE_HMAC_SECRET=
# Khóa dịch vụ gửi email cho worker đọc notification_outbox.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=
